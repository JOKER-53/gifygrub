#!/usr/bin/env bash
#
# gifygrub — generate a static GRUB2 boot theme (background.png + theme.txt)
# from a GIF.
#
# NOTE: GRUB2 has no native mechanism for cycling image frames as an
# animation (verified against GRUB's C source — see lib/theme.sh for
# details). gifygrub extracts frames from your GIF and lets you pick
# one (or auto-picks the middle frame) as a static desktop-image theme.
#
# gifygrub does NOT install themes or touch /boot/grub/ — it only
# generates a theme folder (background.png + theme.txt) matching the
# grub-themes convention. Use grub-themes' install.sh to install it.
#
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
LIB_DIR="$(cd -- "${SCRIPT_DIR}/../lib" &> /dev/null && pwd)"

# shellcheck source=../lib/deps.sh
source "${LIB_DIR}/deps.sh"
# shellcheck source=../lib/extract.sh
source "${LIB_DIR}/extract.sh"
# shellcheck source=../lib/theme.sh
source "${LIB_DIR}/theme.sh"

VERSION="0.1.0"

# ---- defaults ----
INPUT=""
THEME_NAME=""
FPS=5
MAX_FPS=10
FRAME_INDEX=""
OUTPUT_DIR=""

usage() {
    cat <<EOF
gifygrub v${VERSION} — generate a static GRUB2 theme from a GIF

Usage:
  gifygrub --input <file.gif> --theme <name> [--fps N] [--frame N] [--output DIR]
  gifygrub --version
  gifygrub --help

Options:
  --input FILE     Path to the source .gif file (required)
  --theme NAME      Name for the generated theme (required)
  --fps N           Frame extraction density, capped at ${MAX_FPS} (default: ${FPS}).
                      Higher fps = more frames to choose from, not faster playback.
  --frame N          Use frame N (1-indexed) as the background instead of the
                      auto-picked middle frame. Run once without --frame first
                      to see how many frames were extracted, then re-run.
  --output DIR       Directory to write the theme folder into (default: ./<theme>)
                      Point this at grub-themes/<slug>/ to drop straight into
                      a grub-themes checkout.
  --help             Show this help
  --version          Show version

How it works:
  GRUB2 has no native support for animating a sequence of images — this
  was verified directly against GRUB's source. gifygrub extracts frames
  from your GIF so you can pick the best-looking one as a static boot
  background, rather than promising animation GRUB can't deliver.

  gifygrub only GENERATES a theme folder (background.png + theme.txt) —
  it does not install to /boot/grub/ or touch your GRUB config. Use
  grub-themes' install.sh (or your own theme manager) to install the
  output. See README.md > How it works.
EOF
}

# ---- arg parsing ----
while [[ $# -gt 0 ]]; do
    case "$1" in
        --input)
            INPUT="${2:-}"
            shift 2
            ;;
        --theme)
            THEME_NAME="${2:-}"
            shift 2
            ;;
        --fps)
            FPS="${2:-}"
            shift 2
            ;;
        --frame)
            FRAME_INDEX="${2:-}"
            shift 2
            ;;
        --output)
            OUTPUT_DIR="${2:-}"
            shift 2
            ;;
        --version)
            echo "gifygrub v${VERSION}"
            exit 0
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# ---- validation ----
if [[ -z "$INPUT" || -z "$THEME_NAME" ]]; then
    echo "error: --input and --theme are required" >&2
    usage >&2
    exit 1
fi

if [[ ! -f "$INPUT" ]]; then
    echo "error: input file not found: $INPUT" >&2
    exit 1
fi

if [[ ! "$INPUT" =~ \.gif$ ]]; then
    echo "error: input file must be a .gif: $INPUT" >&2
    exit 1
fi

if ! [[ "$FPS" =~ ^[0-9]+$ ]]; then
    echo "error: --fps must be a positive integer" >&2
    exit 1
fi

if (( FPS > MAX_FPS )); then
    echo "warning: capping --fps to ${MAX_FPS} (higher only yields more candidate frames, not faster playback — GRUB shows a single static frame)." >&2
    FPS=$MAX_FPS
fi

if [[ -n "$FRAME_INDEX" ]] && ! [[ "$FRAME_INDEX" =~ ^[0-9]+$ ]]; then
    echo "error: --frame must be a positive integer" >&2
    exit 1
fi

# Sanitize theme name (alnum, dash, underscore only) — this becomes a
# folder/slug name, so keep it filesystem- and URL-safe.
if ! [[ "$THEME_NAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "error: --theme must contain only letters, numbers, - and _" >&2
    exit 1
fi

if [[ -z "$OUTPUT_DIR" ]]; then
    OUTPUT_DIR="./${THEME_NAME}"
fi

# ---- pipeline ----
gifygrub::check_deps

WORKDIR="$(mktemp -d "/tmp/gifygrub.XXXXXX")"
trap 'rm -rf "$WORKDIR"' EXIT

echo "==> Extracting frames from ${INPUT}"
gifygrub::extract_frames "$INPUT" "$WORKDIR" "$FPS"

if [[ -n "$FRAME_INDEX" ]]; then
    printf -v FRAME_NAME "frame_%04d.png" "$FRAME_INDEX"
    SELECTED_FRAME="${WORKDIR}/${FRAME_NAME}"
    if [[ ! -f "$SELECTED_FRAME" ]]; then
        echo "error: frame ${FRAME_INDEX} not found (${FRAME_NAME} does not exist)" >&2
        echo "       re-run without --frame to see how many frames were extracted." >&2
        exit 1
    fi
else
    SELECTED_FRAME="$(gifygrub::pick_best_frame "$WORKDIR")"
fi

echo "==> Generating theme '${THEME_NAME}' (background: $(basename "$SELECTED_FRAME"))"
gifygrub::generate_theme "$WORKDIR" "$THEME_NAME" "$SELECTED_FRAME"

mkdir -p "$OUTPUT_DIR"
cp "${WORKDIR}/background.png" "$OUTPUT_DIR"/
cp "${WORKDIR}/theme.txt" "$OUTPUT_DIR"/

echo "==> Done. Theme generated at: ${OUTPUT_DIR}"
echo "    (background.png + theme.txt — install with grub-themes' install.sh, or your own theme manager)"
