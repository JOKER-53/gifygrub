#!/usr/bin/env bash
#
# gifygrub — generate a static GRUB2 boot theme (background.png + theme.txt)
# from a GIF.
#
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
if [[ -d "${SCRIPT_DIR}/../lib" ]]; then
    LIB_DIR="$(cd -- "${SCRIPT_DIR}/../lib" &> /dev/null && pwd)"
elif [[ -d "/usr/local/lib/gifygrub" ]]; then
    LIB_DIR="/usr/local/lib/gifygrub"
else
    echo "error: could not find lib directory" >&2
    exit 1
fi

# shellcheck source=../lib/deps.sh
source "${LIB_DIR}/deps.sh"
# shellcheck source=../lib/extract.sh
source "${LIB_DIR}/extract.sh"
# shellcheck source=../lib/theme.sh
source "${LIB_DIR}/theme.sh"

VERSION="0.2.0"

INPUT=""
THEME_NAME=""
FRAME_INDEX=""
OUTPUT_DIR=""
RESOLUTION=""

usage() {
    cat <<EOF
gifygrub v${VERSION} — generate a static GRUB2 theme from a GIF

Usage:
  gifygrub --input <file.gif> --theme <name> [--frame N] [--resolution WxH] [--output DIR]
  gifygrub --version
  gifygrub --help

Options:
  --input FILE       Path to the source .gif file (required)
  --theme NAME       Name for the generated theme (required)
  --frame N          Use frame N (1-indexed) as the background instead of the
                     auto-picked middle frame.
  --resolution WxH   Target resolution (e.g., 1920x1080). If omitted, the GIF's
                     original resolution is used.
  --output DIR       Directory to write the theme folder into (default: ./<theme>)
  --help             Show this help
  --version          Show version

How it works:
  GRUB2 has no native support for animating a sequence of images. gifygrub
  extracts a single frame from your GIF to use as a static boot background.

  gifygrub only GENERATES a theme folder (background.png + theme.txt) —
  it does not install to /boot/grub/ or touch your GRUB config.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --input)
            INPUT="${2:-}"
            shift 2
            ;;
        --theme)
            THEME_NAME="${2:-}"
            shift 2
            ;;
        --frame)
            FRAME_INDEX="${2:-}"
            shift 2
            ;;
        --resolution)
            RESOLUTION="${2:-}"
            shift 2
            ;;
        --output)
            OUTPUT_DIR="${2:-}"
            shift 2
            ;;
        --fps)
            echo "warning: --fps is ignored in v0.2.0+ (gifygrub extracts a single static frame)" >&2
            shift 2
            ;;
        --no-install)
            echo "warning: --no-install is ignored (gifygrub no longer attempts installation)" >&2
            shift 1
            ;;
        --version)
            echo "gifygrub v${VERSION}"
            exit 0
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [[ -z "$INPUT" || -z "$THEME_NAME" ]]; then
    echo "error: --input and --theme are required" >&2
    usage >&2
    exit 1
fi

if [[ ! -f "$INPUT" ]]; then
    echo "error: input file not found: $INPUT" >&2
    exit 1
fi

if [[ ! "$INPUT" =~ \.gif$ ]]; then
    echo "error: input file must be a .gif: $INPUT" >&2
    exit 1
fi

if [[ -n "$FRAME_INDEX" ]] && ! [[ "$FRAME_INDEX" =~ ^[0-9]+$ ]]; then
    echo "error: --frame must be a positive integer" >&2
    exit 1
fi

if [[ -n "$RESOLUTION" ]] && ! [[ "$RESOLUTION" =~ ^[0-9]+x[0-9]+$ ]]; then
    echo "error: --resolution must be in format WxH (e.g. 1920x1080)" >&2
    exit 1
fi

if ! [[ "$THEME_NAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "error: --theme must contain only letters, numbers, - and _" >&2
    exit 1
fi

if [[ -z "$OUTPUT_DIR" ]]; then
    OUTPUT_DIR="./${THEME_NAME}"
fi

gifygrub::check_deps

WORKDIR="$(mktemp -d "/tmp/gifygrub.XXXXXX")"
trap 'rm -rf "$WORKDIR"' EXIT

TOTAL_FRAMES=$(gifygrub::get_frame_count "$INPUT")
echo "==> Source GIF has ${TOTAL_FRAMES} frames."

if [[ -z "$FRAME_INDEX" ]]; then
    FRAME_INDEX=$(( TOTAL_FRAMES / 2 ))
    if (( FRAME_INDEX < 1 )); then FRAME_INDEX=1; fi
    echo "==> Auto-selected middle frame: ${FRAME_INDEX}"
else
    if (( FRAME_INDEX > TOTAL_FRAMES || FRAME_INDEX < 1 )); then
        echo "error: requested frame ${FRAME_INDEX} is out of bounds (1-${TOTAL_FRAMES})" >&2
        exit 1
    fi
    echo "==> Using requested frame: ${FRAME_INDEX}"
fi

echo "==> Extracting frame ${FRAME_INDEX} from ${INPUT}"
gifygrub::extract_frame "$INPUT" "$WORKDIR" "$FRAME_INDEX" "$RESOLUTION"

echo "==> Generating theme '${THEME_NAME}'"
gifygrub::generate_theme "$WORKDIR" "$THEME_NAME"

mkdir -p "$OUTPUT_DIR"
cp "${WORKDIR}/background.png" "$OUTPUT_DIR"/
cp "${WORKDIR}/theme.txt" "$OUTPUT_DIR"/

echo "==> Done. Theme generated at: ${OUTPUT_DIR}"
echo "    (background.png + theme.txt — install with your theme manager)"
